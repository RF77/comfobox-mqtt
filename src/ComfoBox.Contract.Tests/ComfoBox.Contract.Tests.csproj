<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contract-Tests: prüfen die MQTT-Kompatibilität gegen docs/topics.json.
    Die Fixture ist unveränderlich - siehe docs/04-migration/mqtt-kompatibilitaet.md
  -->
  <PropertyGroup>
    <!-- Siehe ComfoBox.Domain.csproj: TFM auch in der Projektdatei. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ComfoBox.Contract.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Tests dokumentieren den Vertrag, nicht die Produktions-API -->
    <!-- CA1707: Unterstriche in Testmethodennamen sind hier Haustil. -->
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComfoBox.Domain\ComfoBox.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Die Topic-Fixture ist unveränderlich (Projektregel: "docs/topics.json ist
      die Test-Fixture - nicht verändern"). Sie wird nur in den Ausgabeordner
      kopiert, damit der Test sie ohne Pfad-Salat lesen kann.
    -->
    <None Include="..\..\docs\topics.json" Link="topics.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
