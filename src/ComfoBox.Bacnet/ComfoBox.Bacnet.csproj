<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BACnet-Stapel: nur SerialPort-Zugriff und Logging-Abstraktion.
    Der Codec selbst ist Fremdcode (MIT) - siehe Bacnet/HEADER-LIZENZ.txt
  -->
  <PropertyGroup>
    <!-- Siehe ComfoBox.Domain.csproj: TFM auch in der Projektdatei. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ComfoBox.Bacnet</RootNamespace>
    <AssemblyName>ComfoBox.Bacnet</AssemblyName>
    <!--
      Der portierte Fremdcode (MIT, siehe Bacnet/HEADER-LIZENZ.txt) wird 1:1
      uebernommen. Daher werden folgende Regeln nicht angewendet:
      CS1591 - fehlende XML-Kommentare im Fremdcode
      CS0162 - "unreachable code" nach throw (Originalzustand)
      CS1572 - XML-Kommentar mit unbekanntem param-Tag
      CS1587 - XML-Kommentar ohne Sprachelement

      Die .NET-Analyzer (CAxxxx) sind projektweit abgeschaltet: sie monieren
      im Fremdcode bewusste Eigenheiten des BACnet-Standards (Bezeichner mit
      Unterstrichen, doppelte Enum-Werte, sichtbare Felder). Diese Eigenheiten
      sind Teil des Vertrags und dürfen nicht "verbessert" werden.
      Der neue Code (z. B. Diagnostics/BacnetLog.cs) richtet sich danach.
    -->
    <NoWarn>$(NoWarn);CS1591;CS0162;CS1572;CS1587</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Der MS/TP-Zustandsautomat ist internal, wird aber direkt getestet
      (Aufgabe 1.6: Regression gegen den Spin-Loop aus Befund A8).
    -->
    <InternalsVisibleTo Include="ComfoBox.Bacnet.Tests" />
  </ItemGroup>

</Project>
