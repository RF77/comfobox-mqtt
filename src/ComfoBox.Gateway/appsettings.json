{
  "Gateway": {
    "BaseTopic": "ComfoBox",
    "ExpertMode": false,
    "DataDirectory": "data",
    "AddOnOptionsPath": "/data/options.json",
    "PollIntervalSeconds": 60,
    "SecondaryPollFactor": 5,
    "MaxWritesPer24h": 200
  },
  "Bacnet": {
    "Port": "COM3",
    "Baudrate": 38400,
    "DeviceId": 1,
    "ThisStation": 3,
    "MaxMaster": 127,
    "ItemTimeoutMs": 3000,
    "Retries": 3
  },
  "Mqtt": {
    "KeepAliveSeconds": 30,
    "DiscoveryPrefix": "homeassistant",
    "EnableDiscovery": true,
    "UseMqttRetain": true,
    "StatusIntervalSeconds": 10,
    "Brokers": [
      {
        "Host": "localhost",
        "Port": 1883,
        "UseTls": false
      }
    ]
  },
  "Logging": {
    "Level": "Information",
    "Directory": "logs",
    "RetainedFileCount": 14,
    "RingBuffer": {
      "Capacity": 1000,
      "MinimumLevel": "Information"
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

