<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Gateway-Host: MQTT, REST/SSE-API, BACnet-Anbindung, Logging.
  -->
  <PropertyGroup>
    <!-- Siehe ComfoBox.Domain.csproj: TFM auch in der Projektdatei. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ComfoBox.Gateway</RootNamespace>
    <AssemblyName>ComfoBox.Gateway</AssemblyName>
    <UserSecretsId>comfobox-mqtt-gateway</UserSecretsId>
    <!--
      CA1848 (LoggerMessage-Delegaten) und CA1873 (teure Log-Argumente)
      widersprechen dem in .github/instructions/csharp.instructions.md
      festgelegten Stil: strukturierte Parameter ueber die
      LoggerExtensions-Methoden. Die Regeln werden deshalb hier unterdrueckt -
      die Qualitaets-Gate-Regeln (Warnungen als Fehler) bleiben unberuehrt.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosting/Configuration bringt der Web-SDK bereits mit (NU1510) -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="MQTTnet" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComfoBox.Domain\ComfoBox.Domain.csproj" />
    <ProjectReference Include="..\ComfoBox.Bacnet\ComfoBox.Bacnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Die gebaute Web-Oberfläche (Angular) wird als wwwroot ausgeliefert.
      Der Build findet nur statt, wenn das SPA gebaut wurde (npm run build) -
      sonst bleibt wwwroot leer und die API funktioniert trotzdem.
    -->
    <Content Include="..\ComfoBox.Web\dist\ComfoBox.Web\browser\**"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\ComfoBox.Web\dist\ComfoBox.Web\browser')" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Die Gateway-Tests greifen auf interne Typen zu (BrokerConnection,
      MqttSubscriber.HandleAsync). Die Test-Naehte bleiben dadurch intern.
    -->
    <InternalsVisibleTo Include="ComfoBox.Gateway.Tests" />
  </ItemGroup>

</Project>
