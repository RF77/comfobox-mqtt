# ─────────────────────────────────────────────────────────────────────────────
# Beispiel-Konfiguration für docker compose.
#
# Kopieren:  cp .env.example .env
#
# WICHTIG: Diese Datei darf KEINE Passwörter enthalten. Passwörter und
# API-Token stehen in der config.json im Volume comfobox-data (Modus 0600)
# und werden vom Gateway selbst geschrieben – so erscheinen sie nicht in
# `docker inspect`.
# ─────────────────────────────────────────────────────────────────────────────

# Image mit konkreter Version (nie "latest" in Produktion).
COMFOBOX_IMAGE=ghcr.io/rf77/comfobox-gateway:1.0.1

# Port, unter dem die Web-Oberfläche und die API erreichbar sind.
COMFOBOX_WEB_PORT=8081

# Serielle Schnittstelle (by-id-Pfad ist reboot-stabil).
COMFOBOX_SERIAL_DEVICE=/dev/serial/by-id/usb-Prolific_USB-Serial-if00-port0
COMFOBOX_SERIAL_PORT=/dev/ttyUSB0
COMFOBOX_BACNET_BAUDRATE=38400

# Gruppen-GID des seriellen Ports (dialout = 20 auf DSM und Debian).
COMFOBOX_DIALOUT_GID=20

# Verzeichnis für die Logdateien (Bind-Mount auf den Host).
COMFOBOX_LOG_DIR=./logs
