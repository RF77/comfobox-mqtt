#!/bin/sh
# ---------------------------------------------------------------------------
# start-stop-status – Lifecycle des Pakets.
#
#   start     nichts zu tun – der DSM-Worker "docker-project" startet das
#             Compose-Projekt. Er arbeitet als Root; das Paket selbst hat
#             auf DSM 7 keine Root-Rechte.
#   stop      nichts zu tun – der Worker stoppt das Projekt. Dadurch sieht
#             Home Assistant beim Stopp zuverlässig 'offline'.
#   status    0 = Container läuft, 1 = Container läuft nicht
#   log       das Paket-Log ausgeben
#
# Das ist exakt das Muster des offiziellen DSM-Beispiels:
# https://help.synology.com/developer-guide/examples/compile_docker_package.html
# ---------------------------------------------------------------------------

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$SELF_DIR/../target/bin/common.sh" ]; then
    # shellcheck source=../target/bin/common.sh
    . "$SELF_DIR/../target/bin/common.sh"
fi

case "${1:-}" in
    start)
        exit 0
        ;;

    stop)
        exit 0
        ;;

    status)
        # docker_inspect ist ein DSM-Werkzeug und darf als Paket-Benutzer
        # aufgerufen werden (es arbeitet über den Docker-Daemon des DSM).
        if [ -x /usr/local/bin/docker_inspect ]; then
            if /usr/local/bin/docker_inspect comfobox-gateway 2>/dev/null \
                | grep -q '"Status": "running"'; then
                exit 0
            fi
            exit 1
        fi
        # Ohne das Werkzeug lässt sich der Status nicht ermitteln – der
        # Paketstatus bleibt dann unverändert.
        exit 0
        ;;

    log)
        if [ -n "$LOG_FILE" ] && [ -f "$LOG_FILE" ]; then
            cat "$LOG_FILE"
        fi
        exit 0
        ;;

    *)
        exit 0
        ;;
esac
