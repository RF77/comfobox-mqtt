#!/bin/sh
# ---------------------------------------------------------------------------
# postupgrade – Umgebung nach dem Update herstellen.
#
# WICHTIG: Ein Rückgabewert != 0 macht den Paketstatus "kaputt". Dieses
# Skript beendet deshalb IMMER mit 0.
#
# Zusammen mit preupgrade verhindert dieses Skript den **Fehler 261**
# ("package does not have preupgrade / postupgrade script"), den das DSM
# beim Update sonst meldet.
#
# Was hier passiert:
#   * Die Verzeichnisse des Pakets werden sichergestellt (sie koennen
#     beim Update fehlen, wenn das Paket vorher fehlgeschlagen war).
#   * Das Compose-Projekt aktualisiert der DSM-Worker "docker-project"
#     selbst - hier wird nichts gestartet.
# ---------------------------------------------------------------------------

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for _cand in \
    "${SYNOPKG_PKGDEST:-}/bin/common.sh" \
    "$SELF_DIR/../bin/common.sh" \
    "$SELF_DIR/../target/bin/common.sh"
do
    if [ -n "$_cand" ] && [ -f "$_cand" ]; then
        # shellcheck source=../target/bin/common.sh
        . "$_cand"
        break
    fi
done

echo "ComfoBox Gateway: Update wird abgeschlossen …"

# Verzeichnisse anlegen (unbedingt - ohne sie findet der Container sein
# Datenverzeichnis nicht und die Konfiguration geht verloren).
if command -v prepare_permissions >/dev/null 2>&1; then
    prepare_permissions 2>/dev/null || true
else
    VAR_DIR="/var/packages/ComfoBoxGateway/var"
    mkdir -p "$VAR_DIR" "$VAR_DIR/logs" 2>/dev/null || true
    chmod 0777 "$VAR_DIR" "$VAR_DIR/logs" 2>/dev/null || true
fi

# Der 24-h-Schreibzaehler (EEPROM-Schutz) und die Konfiguration muessen
# ueber ein Update hinweg erhalten bleiben. Sie liegen unter var/ und
# werden vom DSM nicht angefasst - hier nur sicherstellen, dass die
# Rechte noch passen.
if [ -n "${CONFIG_FILE:-}" ] && [ -f "$CONFIG_FILE" ]; then
    chmod 0666 "$CONFIG_FILE" 2>/dev/null || true
fi

echo "Update abgeschlossen."
exit 0
