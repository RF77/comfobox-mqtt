#!/bin/sh
# ---------------------------------------------------------------------------
# postinst – Umgebung nach der Installation vorbereiten.
#
# Reihenfolge laut DSM:
#   prereplace → preinst → postinst → postreplace → start-stop-status start
#
# Der Container wird hier NICHT gestartet. Das übernimmt der DSM-Worker
# "docker-project" (conf/resource): Er legt das Compose-Projekt an und
# startet bzw. stoppt es beim Start/Stopp des Pakets – als Root.
#
# Grund: Auf DSM 7 werden Drittanbieter-Paketen mit Root-Rechten abgelehnt
# (conf/privilege mit "run-as": "root" → Fehler 319). Der Worker ist der
# offizielle Weg, privilegierte Aufgaben ohne Root-Rechte des Pakets zu
# erledigen.
# ---------------------------------------------------------------------------

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -f "$SELF_DIR/../target/bin/common.sh" ]; then
    # shellcheck source=../target/bin/common.sh
    . "$SELF_DIR/../target/bin/common.sh"
else
    echo "ComfoBox Gateway: common.sh nicht gefunden."
    exit 1
fi

echo "ComfoBox Gateway: Umgebung wird vorbereitet …"

# 1) Verzeichnisse anlegen
prepare_permissions

# 2) Skripte ausführbar machen
chmod 755 "${PKG_DIR}/bin/"*.sh 2>/dev/null || true

# 3) Erste Ports-Ermittlung (Anzeige im Getting-Started-Assistenten)
if [ -x "${PKG_DIR}/bin/serial-scan.sh" ]; then
    if "${PKG_DIR}/bin/serial-scan.sh" "${PORTS_FILE}.tmp" >/dev/null 2>&1; then
        mv -f "${PORTS_FILE}.tmp" "$PORTS_FILE"
    else
        rm -f "${PORTS_FILE}.tmp" 2>/dev/null || true
    fi
    chmod 0666 "$PORTS_FILE" 2>/dev/null || true
fi

# 4) Startkonfiguration schreiben, falls noch keine existiert
#
# Die Datei folgt dem Schema der .NET-Konfiguration des Gateways
# (Abschnittsnamen in Großbuchstaben). Das Gateway liest sie UND die
# appsettings.json des Images – die Datei hat Vorrang.
#
# Deshalb wird hier bewusst nur das geschrieben, was der Setup-Modus
# wirklich braucht:
#
#   * "Api:SetupCompleted" = false → die Setup-Endpunkte sind offen.
#   * Kein "Bacnet:Port"     → der Wert aus dem Image (/dev/ttyUSB0) gilt.
#   * Kein "Mqtt:Brokers"    → der Wert aus dem Image (localhost:1883) gilt.
#
# Ein leerer Broker oder ein leerer Port würden beim Start des Gateways die
# Validierung fehlschlagen lassen - der Container würde in einer
# Neustartschleife hängen bleiben und der Assistent wäre nicht erreichbar.
if [ ! -f "$CONFIG_FILE" ]; then
    cat > "$CONFIG_FILE" <<'EOF'
{
  "SchemaVersion": 1,
  "Api": {
    "SetupCompleted": false
  }
}
EOF
    log "Startkonfiguration geschrieben (Setup-Modus)"
fi
# Der Container läuft mit uid 1001 und muss die Datei lesen und schreiben
# können → 0666 (der übergeordnete Pfad /var/packages ist nur für
# System-Benutzer lesbar).
chmod 0666 "$CONFIG_FILE" 2>/dev/null || true

log "postinst abgeschlossen"
echo "ComfoBox Gateway ist vorbereitet. Die Web-Oberfläche öffnet sich automatisch."
exit 0
