#!/bin/sh
# ---------------------------------------------------------------------------
# preinst – Prüfungen VOR der Installation.
#
# WICHTIG (DSM 7):
#   * Das Skript läuft als Paket-Benutzer, NICHT als Root.
#   * Es darf KEINE Seiteneffekte haben – nur Bedingungen prüfen. Ein
#     Rückgabewert != 0 bricht die Installation ab.
#   * `set -u` wird hier bewusst NICHT gesetzt: in dieser Phase ist
#     SYNOPKG_PKGDEST nicht garantiert gesetzt. Ein "unbound variable"
#     war die Ursache fuer "failed to run preinst script" (Fehler 1).
#
# common.sh wird ueber den relativen Pfad geladen - so funktioniert das
# Skript auch dann, wenn das Paketzentrum keine Umgebungsvariablen setzt.
# ---------------------------------------------------------------------------

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -f "$SELF_DIR/../target/bin/common.sh" ]; then
    # shellcheck source=../target/bin/common.sh
    . "$SELF_DIR/../target/bin/common.sh"
else
    echo "ComfoBox Gateway: common.sh nicht gefunden - das Paket ist unvollständig."
    exit 1
fi

echo "ComfoBox Gateway: Voraussetzungen werden geprüft …"

# 1) DSM-Version
DSM_MAJOR=$(echo "${SYNOPKG_DSM_VERSION_MAJOR:-0}" | cut -d. -f1)
if [ "$DSM_MAJOR" -lt 7 ]; then
    echo "ComfoBox Gateway benötigt DSM 7.2 oder neuer."
    exit 1
fi

# 2) Container Manager
#
# Nur eine WARNUNG - kein Abbruch. Die Abhängigkeit ist in der INFO
# deklariert ("install_dep_packages"), das Paketzentrum installiert und
# startet den Container Manager bei Bedarf selbst. Ein harter Abbruch
# blockierte die Installation komplett, obwohl der Container Manager
# nachinstalliert werden konnte.
if command -v synopkg >/dev/null 2>&1; then
    if ! synopkg status ContainerManager >/dev/null 2>&1; then
        if [ ! -x /var/packages/ContainerManager/target/usr/bin/docker ]; then
            echo "Hinweis: Der Container Manager ist noch nicht installiert."
            echo "         Das Paketzentrum installiert ihn bei Bedarf nach."
        fi
    fi
fi

# 3) Admin-Port belegt? (nur Warnung)
PORT=""
if [ -f "$PKG_DIR/INFO" ]; then
    PORT=$(sed -n 's/^adminport="\([0-9]*\)".*/\1/p' "$PKG_DIR/INFO" 2>/dev/null | head -n 1)
fi
[ -n "$PORT" ] || PORT="8081"

if command -v netstat >/dev/null 2>&1; then
    if netstat -an 2>/dev/null | grep -q ":$PORT .*LISTEN"; then
        echo "Hinweis: Der Port $PORT ist bereits belegt."
        echo "         Die Web-Oberfläche ist dann unter einem anderen Port erreichbar."
    fi
fi

echo "Alle Voraussetzungen erfüllt."
exit 0
