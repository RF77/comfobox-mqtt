#!/bin/sh
# ---------------------------------------------------------------------------
# preinst – Bedingungen VOR der Installation prüfen.
#
# WICHTIG (DSM 7):
#   * Ein Rückgabewert != 0 BRICHT die Installation ab. Das Paketzentrum
#     meldet dann nur "Paket kann nicht installiert werden" – ohne Hinweis
#     auf die Ursache. Dieses Skript beendet deshalb IMMER mit 0.
#   * Es darf sich auf KEINE Datei aus dem Paket verlassen! Zum Zeitpunkt
#     von preinst ist das Zielverzeichnis noch NICHT gefüllt: das
#     package.tgz wird erst danach entpackt. Revision 0005 ist genau
#     daran gescheitert – preinst lud "target/bin/common.sh", die es in
#     dieser Phase noch gar nicht gab, und brach mit exit 1 ab.
#   * Keine Seiteneffekte – nur Bedingungen prüfen.
# ---------------------------------------------------------------------------

echo "ComfoBox Gateway: Voraussetzungen werden geprüft …"

# ---------------------------------------------------------------------------
# Das Datenverzeichnis anlegen - HIER, nicht erst im postinst.
#
# Grund: Der DSM-Worker "docker-project" laeuft **vor** dem postinst. Er
# startet den Container, und Docker legt ein fehlendes Host-Verzeichnis
# **als root:root** an. Der Container laeuft aber als uid 1001 (comfobox)
# und koennte dann weder die config.json schreiben noch den
# 24-h-Schreibzaehler (EEPROM-Schutz) sichern.
#
# Das Verzeichnis gehoert dem Paket-Benutzer - das Anlegen ist deshalb
# erlaubt und gehoert sogar zum Paket.
# ---------------------------------------------------------------------------
VAR_DIR="/var/packages/ComfoBoxGateway/var"
if mkdir -p "$VAR_DIR" 2>/dev/null; then
    chmod 0777 "$VAR_DIR" 2>/dev/null || true
fi

# 1) DSM-Version – nur eine Warnung. Die Mindestversion steht in der INFO,
#    deshalb bietet DSM das Paket auf älteren Systemen ohnehin nicht an.
DSM_MAJOR=$(echo "${SYNOPKG_DSM_VERSION_MAJOR:-7}" | cut -d. -f1)
case "$DSM_MAJOR" in
    ''|*[!0-9]*) DSM_MAJOR=7 ;;
esac
if [ "$DSM_MAJOR" -lt 7 ]; then
    echo "ComfoBox Gateway benötigt DSM 7.2 oder neuer."
fi

# 2) Belegter Web-Port – nur eine Warnung.
#    SYNOPKG_PKGPORT wird vom Paketzentrum gesetzt (adminport aus der INFO).
PORT="${SYNOPKG_PKGPORT:-8081}"
if command -v netstat >/dev/null 2>&1; then
    if netstat -an 2>/dev/null | grep -q ":${PORT} .*LISTEN"; then
        echo "Hinweis: Der Port ${PORT} ist bereits belegt."
        echo "         Die Web-Oberfläche ist dann unter einem anderen Port erreichbar."
    fi
fi

# 3) Container Manager – nur eine Warnung. Die Abhängigkeit steht in der
#    INFO (install_dep_packages); das Paketzentrum installiert und startet
#    ihn bei Bedarf selbst. Ein harter Abbruch hier würde die Installation
#    komplett verhindern.
if command -v synopkg >/dev/null 2>&1; then
    if ! synopkg status ContainerManager >/dev/null 2>&1; then
        echo "Hinweis: Der Container Manager läuft noch nicht."
        echo "         Das Paketzentrum startet ihn bei Bedarf."
    fi
fi

echo "Alle Voraussetzungen erfüllt."
exit 0
