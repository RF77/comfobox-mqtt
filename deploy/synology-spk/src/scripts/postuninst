#!/bin/sh
# ---------------------------------------------------------------------------
# postuninst – Aufräumen nach der Deinstallation.
#
# WICHTIG: Die persistenten Daten (config.json, writes.json, logs) bleiben
# erhalten! Grund:
#   • Der 24-h-Schreibzähler (EEPROM-Schutz) darf nicht zurückgesetzt werden.
#   • Eine versehentliche Deinstallation ist mit den Daten jederzeit rückgängig
#     zu machen.
# Der Benutzer kann die Daten manuell unter var/ löschen.
#
# Container und Compose-Projekt entfernt der DSM-Worker "docker-project"
# selbst - deshalb ist hier nichts zu tun.
# ---------------------------------------------------------------------------

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# common.sh robust laden (siehe postinst fuer die Erklaerung).
for _cand in \
    "${SYNOPKG_PKGDEST:-}/bin/common.sh" \
    "$SELF_DIR/../bin/common.sh" \
    "$SELF_DIR/../target/bin/common.sh"
do
    if [ -n "$_cand" ] && [ -f "$_cand" ]; then
        # shellcheck source=../target/bin/common.sh
        . "$_cand"
        break
    fi
done

if [ -n "${VAR_DIR:-}" ] && [ -d "${VAR_DIR}" ]; then
    log "Datenverzeichnis bleibt erhalten: $VAR_DIR"
    echo "Die Konfiguration bleibt unter $VAR_DIR erhalten."
    echo "Zum vollständigen Entfernen bitte dieses Verzeichnis manuell löschen."
fi

exit 0
