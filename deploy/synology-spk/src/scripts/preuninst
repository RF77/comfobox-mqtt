#!/bin/sh
# ---------------------------------------------------------------------------
# preuninst – vor der Deinstallation.
#
# Nichts zu tun: das Compose-Projekt stoppt der DSM-Worker "docker-project"
# beim Release (conf/resource). Das ist das Muster des offiziellen
# DSM-Beispiels für ein Docker-Paket.
# ---------------------------------------------------------------------------

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$SELF_DIR/../target/bin/common.sh" ]; then
    # shellcheck source=../target/bin/common.sh
    . "$SELF_DIR/../target/bin/common.sh"
fi

echo "ComfoBox Gateway: wird deinstalliert …"
exit 0
