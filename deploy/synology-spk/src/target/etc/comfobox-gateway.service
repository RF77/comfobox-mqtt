[Unit]
Description=ComfoBox Gateway Supervisor
Documentation=https://github.com/RF77/comfobox-mqtt
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/var/packages/ComfoBoxGateway/target/bin/supervisor.sh run
ExecStop=/var/packages/ComfoBoxGateway/target/bin/supervisor.sh stop
Restart=always
RestartSec=5
TimeoutStopSec=30
# Der Supervisor braucht Root für udev-Regeln und den Docker-Zugriff
User=root

[Install]
WantedBy=multi-user.target
