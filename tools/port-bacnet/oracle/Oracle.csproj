<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0618;CS0168;CS0219;CS8632;CS1591</NoWarn>
    <AssemblyName>Oracle</AssemblyName>
    <RootNamespace>Oracle</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Der Legacy-Codec wird nur als Referenz-Oracle kompiliert. -->
    <Compile Include="..\..\..\src_old\Bacnet\BACnetBase.cs" Link="BACnetBase.cs" />
  </ItemGroup>

</Project>
